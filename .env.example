# Set these before the first start. Existing saved configuration and credentials win.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
CADDY_DOMAINS=home.lab,testhome.lab
ADGUARD_IP=192.168.1.100
DISCORD_WEBHOOK_URL=

BIND_ADDRESS=0.0.0.0
MANAGER_PORT=5000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Set this to a published image when distributing the stack through a registry.
CADDY_MANAGER_IMAGE=caddymanager:2.0.0
CADDY_IMAGE=caddy:2.11.7
